# =====================================================================
# Copier ce fichier en .env :  cp .env.example .env   (ou : make init)
# Ne JAMAIS committer le fichier .env (il est dans .gitignore).
# =====================================================================

# --- Kafka (E1) -------------------------------------------------------
KAFKA_TOPIC=messages
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8090

# --- Producteur (E1) --------------------------------------------------
# live = rejeu en flux ; backfill = envoi de l'historique (entraînement)
PRODUCER_MODE=live
PRODUCER_RATE=5
PRODUCER_LOOP=true

# --- MinIO / Data Lake (E2) -------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL (métadonnées Airflow/Superset + copie du Gold) ---------
POSTGRES_USER=il15
POSTGRES_PASSWORD=il15_password
POSTGRES_PORT=5432

# --- Spark (E3) -------------------------------------------------------
SPARK_UI_PORT=8082
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=3g

# --- Airflow (E4) -----------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
# GID du groupe « docker » de la machine (Linux : getent group docker)
DOCKER_GID=999
# Clé de développement uniquement
AIRFLOW_FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- Superset (E4) ----------------------------------------------------
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
